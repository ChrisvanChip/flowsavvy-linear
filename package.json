{
  "name": "flowsavvy-linear",
  "version": "2.0.0",
  "private": true,
  "description": "Sync assigned Linear issues to FlowSavvy on Cloudflare Workers",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "types": "wrangler types",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc",
    "test": "node --test tests/*.test.ts",
    "check": "npm run format:check && npm run typecheck && npm test && wrangler deploy --dry-run",
    "migrate": "wrangler d1 migrations apply flowsavvy-linear",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "hono": "^4.9.2"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "prettier": "^3.9.6",
    "typescript": "^7.0.0",
    "wrangler": "^4.28.1"
  }
}
